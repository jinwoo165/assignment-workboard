# Only a NEW assignment project. Existing project references are rejected.
VITE_ASSIGNMENT_SUPABASE_URL=
VITE_ASSIGNMENT_PROJECT_REF=
VITE_ASSIGNMENT_SUPABASE_KEY=
# Enable only after configuring provider credentials/redirect URLs in the NEW project.
VITE_ASSIGNMENT_OAUTH_PROVIDERS=
VITE_ASSIGNMENT_SIGNUP_ENABLED=true
# HTTPS remote MCP endpoint, optional until deployed.
VITE_ASSIGNMENT_MCP_URL=
# Optional: Microsoft Entra SPA application. Public IDs only; NEVER a client secret.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=organizations
