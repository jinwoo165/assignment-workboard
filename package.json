{
  "name": "assignment-personal-workboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base=./ --outDir docs",
    "test": "node --test tests/*.test.js",
    "check:isolation": "node scripts/check-isolation.mjs",
    "build:deploy": "node scripts/check-isolation.mjs --deployment && vite build --base=./ --outDir docs && node scripts/check-isolation.mjs",
    "test:database": "node tests/assignment-database.integration.mjs",
    "build:database": "node scripts/build-assignment-database.mjs",
    "start": "node bridge/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "jose": "6.2.18"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "vite": "8.3.7"
  }
}
